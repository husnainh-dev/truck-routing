# Optional. Truck routes from OpenRouteService (free key: https://account.heigit.org/signup).
# Without it the app uses public OSRM car routes.
ORS_API_KEY=

# Optional weather settings. With neither set, the free Open-Meteo API is used.
# Paid Open-Meteo key (uses customer-api.open-meteo.com, much higher limits):
OPEN_METEO_API_KEY=
# Self-hosted Open-Meteo forecast endpoint, e.g. http://localhost:8080/v1/forecast
OPEN_METEO_URL=
# Weather locations used for the corridor heatmap per plan (each one is an Open-Meteo call).
HEATMAP_CELL_BUDGET=250
# How long forecasts are cached, in seconds.
WEATHER_CACHE_SECONDS=1800
